# Copy to secrets.toml for local use, or paste the contents into
# Settings and Secrets in Streamlit Cloud. Never commit secrets.toml itself.

# Password for the data page at ?view=admin.
# Without it that page stays closed, so a deployed app is never public.
ADMIN_PASSWORD = "choose-something-long"

# Where the data is written. Leave this out and the app uses a local SQLite
# file, which is right on your own machine but is LOST ON EVERY RESTART of a
# hosted app. Set it before collecting real data.
# DATABASE_URL = "postgresql://user:password@host:5432/dbname?sslmode=require"
